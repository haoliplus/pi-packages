{
  "$schema": "../schemas/permissions.schema.json",
  "yoloMode": false,
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "path_read": { "*": "allow" },
    "path_write": { "*": "ask", "/dev/null": "allow" },
    "external_directory": { "*": "ask" },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "stat *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "find * -exec*": "deny",
      "find * -delete*": "deny",
      "find * -ok*": "deny"
    }
  }
}
